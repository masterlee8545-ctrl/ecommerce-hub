{
  "version": 1,
  "selectors": {
    "sello.row": {
      "kind": "css",
      "primary": "ul.td[data-rank]",
      "fallbacks": [
        "ul[data-rank]",
        "[data-rank][data-coupangid]"
      ],
      "contract": {
        "minMatches": 1,
        "attr": "data-rank",
        "mustMatch": "^\\d+$"
      },
      "within": null,
      "description": "셀록홈즈 쿠팡 1페이지 분석표의 상품 행 하나",
      "sampleUrls": [],
      "requiresBrowser": true,
      "healedAt": null,
      "healedFrom": null
    },
    "sello.row_name": {
      "kind": "css",
      "primary": "li.name .goods-name",
      "fallbacks": [
        "li.name"
      ],
      "contract": {
        "minMatches": 1,
        "minTextLen": 2
      },
      "within": "sello.row",
      "description": "행의 상품명",
      "sampleUrls": [],
      "requiresBrowser": true,
      "healedAt": null,
      "healedFrom": null
    },
    "sello.row_link": {
      "kind": "css",
      "primary": "li.name .goods-name a",
      "fallbacks": [
        "li.name a[href*='coupang.com']"
      ],
      "contract": {
        "minMatches": 1,
        "attr": "href",
        "mustMatch": "coupang\\.com|/vp/products/"
      },
      "within": "sello.row",
      "description": "행의 쿠팡 상품 링크",
      "sampleUrls": [],
      "requiresBrowser": true,
      "healedAt": null,
      "healedFrom": null
    },
    "sello.row_image": {
      "kind": "css",
      "primary": "li.name .prd-img img",
      "fallbacks": [
        "li.name img"
      ],
      "contract": {
        "minMatches": 1,
        "attr": "src"
      },
      "within": "sello.row",
      "description": "행의 상품 썸네일. 지연 로딩 플레이스홀더(data URI·상대경로)에서 정상 화면을 실패로 만들지 않도록 값 형식은 검사하지 않고 src 속성 존재만 본다",
      "sampleUrls": [],
      "requiresBrowser": true,
      "healedAt": null,
      "healedFrom": null
    },
    "sello.row_price": {
      "kind": "css",
      "primary": "li.price",
      "fallbacks": [],
      "contract": {
        "minMatches": 1,
        "mustMatch": "\\d"
      },
      "within": "sello.row",
      "description": "행의 판매가",
      "sampleUrls": [],
      "requiresBrowser": true,
      "healedAt": null,
      "healedFrom": null
    },
    "sello.row_review": {
      "kind": "css",
      "primary": "li.review .num",
      "fallbacks": [],
      "contract": {
        "minMatches": 1
      },
      "within": "sello.row",
      "description": "행의 리뷰 수. 신상품은 0 도 정상값이라 숫자 제약을 걸지 않는다",
      "sampleUrls": [],
